POLICY_RAG_ENV=development
POLICY_RAG_HOST=127.0.0.1
POLICY_RAG_PORT=8000
POLICY_RAG_API_URL=http://127.0.0.1:8000
POLICY_RAG_RELOAD=false
POLICY_RAG_LOG_LEVEL=INFO
POLICY_RAG_LOG_JSON=false
POLICY_RAG_DB=storage/policy_rag.sqlite3
POLICY_RAG_MODELS_ENABLED=true
POLICY_RAG_MODEL_DEVICE=cpu
POLICY_RAG_TORCH_THREADS=4
POLICY_RAG_EMBEDDING_MODEL=models/bge-small-zh-v1.5
POLICY_RAG_EMBEDDING_BATCH_SIZE=32
POLICY_RAG_RERANK_ENABLED=true
POLICY_RAG_RERANK_MODEL=models/bge-reranker-base
POLICY_RAG_RERANK_CANDIDATES=20
POLICY_RAG_RERANK_MAX_LENGTH=256
POLICY_RAG_LLM_PROVIDER=none
POLICY_RAG_LLM_MODEL=
POLICY_RAG_LLM_BASE_URL=
POLICY_RAG_LLM_API_KEY=
POLICY_RAG_LLM_TIMEOUT_SECONDS=90
POLICY_RAG_LLM_MAX_RETRIES=2
POLICY_RAG_LLM_REPAIR_RETRIES=1
POLICY_RAG_LLM_TEMPERATURE=0
POLICY_RAG_LLM_MAX_TOKENS=700
POLICY_RAG_LLM_EVIDENCE_LIMIT=4
POLICY_RAG_LLM_ENABLE_THINKING=false
POLICY_RAG_LLM_JSON_MODE=true
POLICY_RAG_LLM_INPUT_COST_PER_MILLION=0
POLICY_RAG_LLM_OUTPUT_COST_PER_MILLION=0
POLICY_RAG_LLM_COST_CURRENCY=CNY
